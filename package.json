{
  "name": "station-node",
  "version": "1.2.1",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "repository": "git@github.com:station-guide/station-node.git",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "oxfmt --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.js\"",
    "test": "jest --config jestconfig.json",
    "cover": "jest --config jestconfig.json --coverage",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run lint",
    "preversion": "pnpm run lint",
    "version": "pnpm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "oxfmt": "^0.75.0",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "files": [
    "lib/index.d.ts",
    "lib/index.d.ts.map",
    "lib/index.js",
    "lib/index.js.map"
  ]
}
