{
  "name": "station-node",
  "version": "1.1.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "packageManager": "pnpm@11.1.2",
  "repository": "git@github.com:station-guide/station-node.git",
  "author": "Alexander Pankiv <alexanderpankiv@gmail.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "oxfmt --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.js\"",
    "test": "jest --config jestconfig.json",
    "cover": "jest --config jestconfig.json --coverage",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run lint",
    "preversion": "pnpm run lint",
    "version": "pnpm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "jest": "^30.4.2",
    "oxfmt": "^0.50.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.16.1"
  },
  "pnpm": {
    "overrides": {
      "diff": "^4.0.4"
    }
  },
  "files": [
    "lib/index.d.ts",
    "lib/index.js",
    "lib/index.js.map"
  ]
}
